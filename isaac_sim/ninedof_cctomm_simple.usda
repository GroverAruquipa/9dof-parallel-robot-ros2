#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom bool physxScene:enableGPUDynamics = 0
        custom token physxScene:solverType = "TGS"
        custom uint physxScene:timeStepsPerSecond = 2000
    }

    def Xform "ninedof" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom bool physxArticulation:enabledSelfCollisions = 0
        custom int physxArticulation:solverPositionIterationCount = 64
        custom int physxArticulation:solverVelocityIterationCount = 4

        def "Looks"
        {
            def Material "white"
            {
                token outputs:surface.connect = </World/ninedof/Looks/white/shader.outputs:surface>

                def Shader "shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.95, 0.95, 0.94)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.6
                    token outputs:surface
                }
            }

