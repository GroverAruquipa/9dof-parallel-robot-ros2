<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ninedof_mujoco</name>
  <version>0.1.0</version>
  <description>MuJoCo simulation tools for the 9-DoF 5PSS-S-4PSS parallel robot: state-publisher plugin for mujoco_ros2_control, pick-and-place demo node and offline video renderer.</description>
  <maintainer email="grover.adelante9@gmail.com">Grover Aruquipa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mujoco_ros2_control_plugins</depend>
  <depend>mujoco_vendor</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ninedof_bringup</exec_depend>
  <exec_depend>ninedof_description</exec_depend>
  <exec_depend>ninedof_kinematics</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
