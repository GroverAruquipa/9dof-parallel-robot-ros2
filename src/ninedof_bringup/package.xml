<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ninedof_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and RViz configuration for the 9-DoF 5PSS-S-4PSS parallel robot.</description>
  <maintainer email="grover.adelante9@gmail.com">Grover Aruquipa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ninedof_description</exec_depend>
  <exec_depend>ninedof_kinematics</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
